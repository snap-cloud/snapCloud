#! /usr/bin/env bash

# Simple macOS wrapper around `luarocks` that adds the compiler and openssl
# settings needed to build some rocks (luasec, luaossl, bcrypt).

# Assumes lua 5.1 and luarocks come from mise (see .tool-versions and mise.toml).
# ARM Macs need >= gcc-12. The newest homebrew gcc is used, see bin/setup-macos

OPENSSL_PREFIX="$(brew --prefix openssl@3)"

# Use the newest gcc from the homebrew `gcc` formula, e.g. gcc-15
GCC_PREFIX="$(brew --prefix gcc)"
gcc_command=$(basename "$(ls "$GCC_PREFIX"/bin/gcc-[0-9]* | sort -V | tail -1)")

# Homebrew's gcc looks for the macOS SDK it was built with, which may not
# exist after a macOS update ("ld: library 'System' not found").
export SDKROOT="${SDKROOT:-$(xcrun --show-sdk-path)}"

export CXXFLAGS="-std=c++14"
export CXX=$gcc_command
export CC=$gcc_command
export LD=$gcc_command

# --local installs to ~/.luarocks, which is where mise.toml points LUA_PATH.
# cc, ld flags, openssl, etc are needed for luasec and luaossl
luarocks --local \
  OPENSSL_DIR="$OPENSSL_PREFIX/" \
  CRYPTO_DIR="$OPENSSL_PREFIX/" \
  CXX=$gcc_command \
  LD=$gcc_command \
  CXXFLAGS="-std=c++14" \
  LDFLAGS="-L$OPENSSL_PREFIX/lib" \
  STDCPP_LIBDIR="$GCC_PREFIX/lib/gcc/current/" \
  "$@";
