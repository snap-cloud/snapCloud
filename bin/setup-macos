#!/bin/bash

# snapCloud install script for macOS
# contributed by Michael Ball

print_ok() {
   echo -e "\033[32m$1\033[0m"
}

print_warning() {
    echo -e "\033[33m$1\033[0m"
}

# Ensure brew is installed.
if [[ -z `which brew` ]]; then
    echo 'Please install homebrew before continuing.';
    echo 'Visit brew.sh for instructions.';
    exit 1;
fi

# TODO: move to postgresql@18
POSTGRES_FORMULA='postgresql@16'
# Don't upgrade things that are already installed.
export HOMEBREW_NO_INSTALL_UPGRADE=1
BREW_PREFIX=$(brew --prefix)

# Lua 5.1 is no longer in homebrew, so mise installs lua (and node).
# Versions are pinned in .tool-versions.
# gcc is needed to build some lua rocks, see bin/luarocks-macos
print_ok 'Installing mise, postgres, and build tools'
brew install mise $POSTGRES_FORMULA gcc

print_ok 'Using mise to install lua 5.1 and node (from .tool-versions)'
mise trust
mise install
# Load mise's tools and the lua paths from mise.toml for the rest of this script.
eval "$(mise env -s bash)"

if [[ -z `which npm` ]]; then
    echo 'npm was not found. It is needed for sass (css) and maildev (an email catcher).'
    echo 'Please install node (npm), then re-run this script.'
    exit 1;
fi

print_ok 'Installing OpenResty'
# The geoip module needs a library that is no longer in homebrew. We do not use it.
brew install openresty/brew/openresty --without-geoip

print_ok "Setting Git to use https:// instead of unsecured git:// for GitHub"
git config --global url."https://github".insteadOf git://github

print_ok "Installing Lapis, Lua & npm Dependencies"
make install

# Postgres is keg-only, so its tools (psql, createdb, pg_dump) are not on the PATH.
export PATH="$BREW_PREFIX/opt/$POSTGRES_FORMULA/bin:$PATH"

case "$SHELL" in
    */zsh) SHELL_RC="$HOME/.zshrc" ;;
    *) SHELL_RC="$HOME/.bashrc" ;;
esac
# mise sets LUA_PATH and LUA_CPATH from mise.toml when you are in the project.
add_to_shell_rc() {
    # $1: text to look for, $2: line to add if it is missing
    if grep -qF "$1" "$SHELL_RC" 2>/dev/null; then
        print_ok "$SHELL_RC already has $1"
    else
        print_ok "Adding $1 to $SHELL_RC"
        printf '\n# Added by snapCloud bin/setup-macos\n%s\n' "$2" >> "$SHELL_RC"
    fi
}
add_to_shell_rc 'mise activate' "eval \"\$(mise activate ${SHELL##*/})\""
add_to_shell_rc "opt/$POSTGRES_FORMULA/bin" "export PATH=\"$BREW_PREFIX/opt/$POSTGRES_FORMULA/bin:\$PATH\""

print_ok "Prerequisites installed."

if [[ ! -f .env ]]; then
    print_ok "Creating a development .env file"
    cat > .env <<'EOF'
export LAPIS_ENVIRONMENT=development
export DATABASE_HOST=localhost
export DATABASE_USERNAME=$USER
export DATABASE_NAME=snapcloud_development
export PORT=8080
export HOSTNAME=localhost
EOF
fi

if pg_isready -q; then
    print_ok "Postgres is already running."
else
    print_ok "Starting postgres."
    brew services start $POSTGRES_FORMULA
    # Give postgres a moment to accept connections.
    sleep 3
fi

print_ok "Setting up the database."

export LAPIS_ENVIRONMENT=development
bin/lapis-migrate

print_ok "Done! Open a new terminal (or run: source $SHELL_RC) to pick up the new paths."
