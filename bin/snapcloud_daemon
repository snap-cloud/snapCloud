#!/bin/sh
# kFreeBSD do not accept scripts as interpreters, using #!/bin/sh and sourcing.
if [ true != "$INIT_D_SCRIPT_SOURCED" ] ; then
    set "$0" "$@"; INIT_D_SCRIPT_SOURCED=true . /lib/init/init-d-script
fi
### BEGIN INIT INFO
# Provides:          snapcloud
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: SnapCloud initscript
# Description:       Starts the SnapCloud service as user "cloud"
### END INIT INFO

# Author: Bernat Romagosa <bernat@romagosa.work>

NAME=snapcloud
DESC="SnapCloud service"
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin

APP_DIR=/home/cloud/snapCloud
# lapis comes from the project's rocks (bin/install-rocks).
LAPIS_PATH="PATH=$APP_DIR/lua_modules/bin:\$PATH"

case "$1" in
  start|restart|force-reload)
    log_daemon_msg "Starting $DESC" "$NAME"
    killall nginx
    # start.sh launches a background `sass --watch`; stop the old one first
    # or every restart leaves another one running.
    pkill -u cloud -f 'sass --watch' || true
    runuser -l cloud -c "(cd $APP_DIR; ./start.sh &)"
    ;;
  reload)
    # Rebuild nginx.conf and send nginx a HUP: new workers pick up config,
    # certs and Lua code, and open connections are not dropped.
    # Run under authbind (like start.sh) so lapis/nginx may touch the
    # privileged :80/:443 listeners during the rebuild; without it the reload
    # fails with "bind() ... Permission denied" (cloud can't bind <1024).
    log_daemon_msg "Reloading $DESC" "$NAME"
    runuser -l cloud -c "cd $APP_DIR && . ./.env && $LAPIS_PATH authbind --deep lapis build \$LAPIS_ENVIRONMENT"
    ;;
  stop)
    log_daemon_msg "Stopping $DESC" "$NAME"
    runuser -l cloud -c "cd $APP_DIR && $LAPIS_PATH lapis term"
    killall nginx
    pkill -u cloud -f 'sass --watch' || true
    ;;
esac

