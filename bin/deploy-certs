#!/usr/bin/env sh

## NOTE: lets-encrypt renewals runs this using sh not bash.
## pushd / popd are not available.
cwd=$(pwd);
USER='cloud'
REPO_DIR="/home/$USER/snapCloud";

cd $REPO_DIR;
. $REPO_DIR/.env

curl -XPOST https://hooks.slack.com/workflows/T02BLN36L/A01PUMAEUPR/344588914394149899/$SLACK_KEY \
 -H 'Content-Type: application/json' \
 -d "{\"message\":\"Running cert deployment for $LAPIS_ENVIRONMENT\"}"

# MUST USE -L. LetsEncrypt uses symlinks
# TODO: Clean this up... use $RENEWED_DOMAINS?
sourceDir=/home/$USER/lets-encrypt/live/
destDir=$REPO_DIR/certs/

if [ "$LAPIS_ENVIRONMENT" = 'production' ]; then
    domains='snap.berkeley.edu extensions.snap.berkeley.edu snap-cloud.cs10.org'
else
    domains='staging.snap.berkeley.edu snap-staging.cs10.org'
fi

for domain in $domains; do
    cp -r -u --verbose -L ${sourceDir}${domain} $destDir;
done

# cp -L writes the private keys with default permissions; keep them private.
chmod 600 ${destDir}*/privkey*.pem

curl -XPOST https://hooks.slack.com/workflows/T02BLN36L/A01PUMAEUPR/344588914394149899/$SLACK_KEY \
 -H 'Content-Type: application/json' \
 -d "{\"message\":\"Deployed Certs to $LAPIS_ENVIRONMENT\"}"

# Reload so nginx picks up the new certs without dropping connections.
sudo service snapcloud_daemon reload;

cd $cwd;
