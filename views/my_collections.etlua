<% content_for('title', locale.get('my_collections')) %>
<h1><%- locale.get('my_collections') %></h1>
<%
render(
    'views.grid',
    {
        class = 'my_collections',
        item_type = 'collection',
        items_per_page = 18,
        with_search = true,
        show_if_empty = true,
        show_author = false,
        show_icons = true,
        show_author = true,
        sort_descriptor = {
            default = 'updated_at',
            default_dir = 'desc',
            options = {
                { label = locale.get('sort_name'), value = 'name' },
                { label = locale.get('sort_created'), value = 'created_at' },
                { label = locale.get('sort_last_updated'), value = 'updated_at' }
            }
        }
    }
)
%>

<div class="my-2">
    <button type=button class="btn btn-lg btn-primary"
       onclick="newCollectionDialog()"><%- locale.get('new_collection') %></button>
    <script>
        function newCollectionDialog () {
            prompt(
                "<%- locale.get('collection_name') %>",
                name => {
                    cloud.post(
                        '/collections/' + encodeURIComponent(<%- util.js_string(session.username) %>),
                        Cloud.redirect,
                        { name: name }
                    );
                },
                nop
            );
        };
    </script>
</div>
