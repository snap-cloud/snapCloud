<link rel="stylesheet" href="/static/style/admin.css">
<% content_for('title', 'User Adminstration') %>

<h1>User Administration</h1>
<%
render(
    'views.grid',
    {
        class = 'user_admin',
        item_type = 'profile',
        -- 12 items w/in one .row get reflowed to 1-3 columns.
        items_per_row = 12,
        with_search = true,
        show_if_empty = true,
        filter_descriptors = {
            {
                selector = 'order_by',
                label = 'Sort by',
                options = {
                    { label = 'Newest', value = 'created DESC' },
                    { label = 'Oldest', value = 'created ASC' },
                    { label = 'Username A-Z', value = 'username ASC' },
                    { label = 'Username Z-A', value = 'username DESC' },
                    { label = 'Email A-Z', value = 'email ASC' },
                    { label = 'Email Z-A', value = 'email DESC' },
                    { label = 'Most sessions', value = 'session_count DESC' },
                    { label = 'Last login', value = 'last_login_at DESC' },
                }
            },
            {
                selector = 'verified',
                label = 'Verified',
                options = {
                    { label = 'Any', value = '' },
                    { label = 'Verified', value = true },
                    { label = 'Unverified', value = false }
                }
            },
            {
                selector = 'is_teacher',
                label = 'Teacher',
                options = {
                    { label = 'Any', value = '' },
                    { label = 'True', value = true },
                    { label = 'False', value = false },
                }
            },
            {
                selector = 'role',
                label = 'Role',
                options = {
                    { label = 'Any', value = '' },
                    { label = 'Standard', value = 'standard' },
                    { label = 'Reviewer', value = 'reviewer' },
                    { label = 'Moderator', value = 'moderator' },
                    { label = 'Administrator', value = 'admin' },
                    { label = 'Student', value = 'student' },
                    { label = 'Banned', value = 'banned' },
                }
            }
        }
    }
)
%>
