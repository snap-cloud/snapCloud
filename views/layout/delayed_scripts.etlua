<script type="text/javascript" src="/static/vendor/js/bootstrap.bundle.min.js?v5.3.8"></script>
<script>
  // Bootstrap tooltips are opt-in: any element with data-bs-toggle="tooltip"
  // gets a styled tooltip from its title attribute.
  document.querySelectorAll('[data-bs-toggle="tooltip"]')
      .forEach(el => new bootstrap.Tooltip(el));
</script>

