<% content_for('title', locale.get('my_projects')) %>
<h1 class="mb-3"><%- locale.get('my_projects') %></h1>

<%
render(
    'views.grid',
    {
        class = 'my_projects',
        item_type = 'project',
        items_per_page = 18,
        items_per_row = 6,
        with_search = true,
        show_if_empty = true,
        show_author = false,
        show_icons = true,
        sort_descriptor = {
            default = 'lastupdated',
            default_dir = 'desc',
            options = {
                { label = locale.get('sort_title'), value = 'projectname' },
                { label = locale.get('sort_created'), value = 'created' },
                { label = locale.get('sort_last_updated'), value = 'lastupdated' }
            }
        }
    }
)
%>
